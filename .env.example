RESERVATION_DB_PASSWORD=REPLACE_WITH_UNIQUE_RESERVATION_PASSWORD
PAYMENT_DB_PASSWORD=REPLACE_WITH_UNIQUE_PAYMENT_PASSWORD
NOTIFICATION_DB_PASSWORD=REPLACE_WITH_UNIQUE_NOTIFICATION_PASSWORD
UI_PORT=8180
