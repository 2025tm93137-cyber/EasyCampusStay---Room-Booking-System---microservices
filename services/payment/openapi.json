  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "PaymentCreate": {
        "properties": {
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "title": "Booking Id"
          },
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          },
          "simulation": {
            "type": "string",
            "enum": [
              "success",
              "decline",
              "slow_success"
            ],
            "title": "Simulation",
            "default": "success"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "booking_id",
          "amount_minor",
          "currency"
        ],
        "title": "PaymentCreate"
      },
      "PaymentResponse": {
        "properties": {
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "title": "Booking Id"
          },
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency"
          },
          "simulation": {
            "type": "string",
            "enum": [
              "success",
              "decline",
              "slow_success"
            ],
            "title": "Simulation",
            "default": "success"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "CHARGED",
              "DECLINED",
              "REFUNDED"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "booking_id",
          "amount_minor",
          "currency",
          "id",
          "status"
        ],
        "title": "PaymentResponse"
      }
    }
  }
