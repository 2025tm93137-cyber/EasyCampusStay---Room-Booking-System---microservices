  "components": {
    "schemas": {
      "BookingCreate": {
        "properties": {
          "room_type_id": {
            "type": "string",
            "format": "uuid",
            "title": "Room Type Id"
          },
          "stay_date": {
            "type": "string",
            "format": "date",
            "title": "Stay Date"
          },
          "guest_ref": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Guest Ref"
          },
          "recipient": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "title": "Recipient",
            "default": "guest@example.test"
          },
          "payment_mode": {
            "type": "string",
            "enum": [
              "success",
              "decline",
              "slow_success"
            ],
            "title": "Payment Mode",
            "default": "success"
          },
          "notification_mode": {
            "type": "string",
            "enum": [
              "success",
              "fail_once"
            ],
            "title": "Notification Mode",
            "default": "success"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_type_id",
          "stay_date",
          "guest_ref"
        ],
        "title": "BookingCreate"
      },
      "BookingResponse": {
        "properties": {
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "title": "Booking Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RESERVED",
              "PAYMENT_PENDING",
              "PAYMENT_UNCERTAIN",
              "PAID",
              "CONFIRMED",
              "COMPENSATING",
              "CANCELLED"
            ],
            "title": "Status"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid",
            "title": "Room Type Id"
          },
          "stay_date": {
            "type": "string",
            "format": "date",
            "title": "Stay Date"
          },
          "amount_minor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "payment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Id"
          },
          "notification_status": {
            "type": "string",
            "enum": [
              "PENDING",
              "SENT"
            ],
            "title": "Notification Status"
          }
        },
        "type": "object",
        "required": [
          "booking_id",
          "status",
          "room_type_id",
          "stay_date",
          "amount_minor",
          "currency",
          "payment_id",
          "notification_status"
        ],
        "title": "BookingResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      }
    }
  }
}
