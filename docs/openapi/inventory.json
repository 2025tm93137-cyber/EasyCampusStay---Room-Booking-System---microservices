            "title": "Booking Id"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid",
            "title": "Room Type Id"
          },
          "stay_date": {
            "type": "string",
            "format": "date",
            "title": "Stay Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "booking_id",
          "room_type_id",
          "stay_date"
        ],
        "title": "HoldCreate"
      },
      "HoldResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "title": "Booking Id"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid",
            "title": "Room Type Id"
          },
          "stay_date": {
            "type": "string",
            "format": "date",
            "title": "Stay Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "HELD",
              "CONFIRMED",
              "RELEASED"
            ],
            "title": "Status"
          },
          "amount_minor": {
            "type": "integer",
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "id",
          "booking_id",
          "room_type_id",
          "stay_date",
          "status",
          "amount_minor",
          "currency"
        ],
        "title": "HoldResponse"
      },
      "RoomTypeCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "capacity": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Capacity"
          },
          "price_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Price Minor"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "default": "INR"
          },
          "dates": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "maxItems": 60,
            "minItems": 1,
            "title": "Dates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "capacity",
          "price_minor",
          "dates"
        ],
        "title": "RoomTypeCreate"
      },
